{
  "urn": "urn:mediator:openmrs-advapacs-fhir",
  "version": "0.1.0",
  "name": "OpenMRS-AdvaPACS FHIR Mediator",
  "description": "Routes radiology ServiceRequests from OpenMRS to AdvaPACS, and receives AdvaPACS's webhook events and creates the matching radiologyapp studies and reports in OpenMRS.",
  "endpoints": [
    {
      "name": "Order Push endpoint",
      "host": "0.0.0.0",
      "port": "3500",
      "primary": true,
      "type": "http",
      "path": "/fhir/ServiceRequest"
    },
    {
      "name": "AdvaPACS webhook endpoint",
      "host": "0.0.0.0",
      "port": "3500",
      "primary": false,
      "type": "http",
      "path": "/webhooks/advapacs"
    },
    {
      "name": "AdvaPACS event processing endpoint",
      "host": "0.0.0.0",
      "port": "3500",
      "primary": false,
      "type": "http",
      "path": "/results/advapacs-event"
    }
  ],
  "defaultChannelConfig": [
    {
      "name": "OpenMRS to Mediator Order Push",
      "urlPattern": "^/fhir/ServiceRequest$",
      "routes": [
        {
          "name": "OpenMRS-AdvaPACS FHIR Mediator route",
          "host": "openhim-advapacs-mediator",
          "port": 3500,
          "primary": true,
          "type": "http"
        }
      ],
      "allow": ["openmrs"],
      "authType": "private",
      "methods": ["POST"],
      "type": "http",
      "autoRetryEnabled": true,
      "autoRetryPeriodMinutes": 1,
      "autoRetryMaxAttempts": 30
    },
    {
      "name": "Mediator to AdvaPACS Order Push",
      "urlPattern": "^/advapacs/.*$",
      "routes": [
        {
          "name": "AdvaPACS FHIR API",
          "host": "example.api.integration.advapacs.com",
          "port": 443,
          "primary": true,
          "type": "http",
          "secured": true,
          "forwardAuthHeader": true,
          "pathTransform": "s/^\\/advapacs//"
        }
      ],
      "allow": [],
      "authType": "public",
      "methods": ["GET", "POST", "PUT"],
      "type": "http",
      "requestBody": true,
      "autoRetryEnabled": true,
      "autoRetryPeriodMinutes": 1,
      "autoRetryMaxAttempts": 5
    },
    {
      "name": "AdvaPACS to Mediator Study and Report Webhook",
      "urlPattern": "^/webhooks/advapacs$",
      "routes": [
        {
          "name": "OpenMRS-AdvaPACS FHIR Mediator webhook route",
          "host": "openhim-advapacs-mediator",
          "port": 3500,
          "primary": true,
          "type": "http",
          "forwardAuthHeader": true
        }
      ],
      "allow": ["advapacs"],
      "authType": "private",
      "methods": ["POST"],
      "type": "http"
    },
    {
      "name": "Mediator to OpenMRS Radiology Results",
      "urlPattern": "^/openmrs/ws/rest/v1/radiologyapp/(studyimport|reportimport)$",
      "routes": [
        {
          "name": "OpenMRS radiologyapp",
          "host": "openmrs",
          "port": 8080,
          "primary": true,
          "type": "http",
          "secured": false,
          "forwardAuthHeader": false,
          "pathTransform": "s/^\\/openmrs/\\/openmrs/"
        }
      ],
      "allow": ["advapacs-mediator"],
      "authType": "private",
      "methods": ["POST"],
      "type": "http",
      "requestBody": true,
      "responseBody": true
    },
    {
      "name": "AdvaPACS Event Processing",
      "urlPattern": "^/results/advapacs-event$",
      "routes": [
        {
          "name": "OpenMRS-AdvaPACS FHIR Mediator results route",
          "host": "openhim-advapacs-mediator",
          "port": 3500,
          "primary": true,
          "type": "http",
          "forwardAuthHeader": false
        }
      ],
      "allow": ["advapacs-mediator"],
      "authType": "private",
      "methods": ["POST"],
      "type": "http",
      "timeout": 10000,
      "requestBody": true,
      "responseBody": true,
      "autoRetryEnabled": true,
      "autoRetryPeriodMinutes": 5,
      "autoRetryMaxAttempts": 24
    }
  ],
  "configDefs": [
    {
      "param": "openmrsBaseUrl",
      "displayName": "OpenMRS FHIR base URL",
      "description": "e.g. https://example.org/openmrs/ws/fhir2/R4",
      "type": "string",
      "defaultValue": "https://example.org/openmrs/ws/fhir2/R4"
    },
    {
      "param": "advapacsBaseUrl",
      "displayName": "AdvaPACS FHIR base URL",
      "description": "e.g. https://usa1.api.integration.advapacs.com/fhir",
      "type": "string",
      "defaultValue": "https://example.api.integration.advapacs.com/fhir"
    },
    {
      "param": "logLevel",
      "displayName": "Log level",
      "type": "option",
      "values": ["debug", "info", "warn", "error"],
      "defaultValue": "info"
    },
    {
      "param": "patientIdentifierSystem",
      "displayName": "Patient identifier system",
      "description": "FHIR identifier system used to reference the patient on outbound ServiceRequests, e.g. http://www.pih.org/identifiers/lesotho/emr-id",
      "type": "string",
      "defaultValue": "http://www.pih.org/identifiers/lesotho/emr-id"
    }
  ]
}
