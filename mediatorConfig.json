{
  "urn": "urn:mediator:openmrs-advapacs-fhir",
  "version": "0.1.0",
  "name": "OpenMRS-AdvaPACS FHIR Mediator",
  "description": "Routes radiology ServiceRequests from OpenMRS to AdvaPACS and delivers AdvaPACS FHIR Subscription results (ImagingStudy / DiagnosticReport) back into OpenMRS.",
  "endpoints": [
    {
      "name": "Order Push endpoint",
      "host": "0.0.0.0",
      "port": "3500",
      "primary": true,
      "type": "http",
      "path": "/fhir/ServiceRequest"
    }
  ],
  "defaultChannelConfig": [
    {
      "name": "OpenMRS to Mediator Order Push",
      "urlPattern": "^/fhir/ServiceRequest$",
      "routes": [
        {
          "name": "OpenMRS-AdvaPACS FHIR Mediator route",
          "host": "openhim-advapacs-mediator",
          "port": 3500,
          "primary": true,
          "type": "http"
        }
      ],
      "allow": ["openmrs"],
      "authType": "private",
      "methods": ["POST"],
      "type": "http"
    },
    {
      "name": "Mediator to AdvaPACS Order Push",
      "urlPattern": "^/advapacs/.*$",
      "routes": [
        {
          "name": "AdvaPACS FHIR API",
          "host": "example.api.integration.advapacs.com",
          "port": 443,
          "primary": true,
          "type": "http",
          "secured": true,
          "forwardAuthHeader": true,
          "pathTransform": "s/^\\/advapacs//"
        }
      ],
      "allow": [],
      "authType": "public",
      "methods": ["GET", "POST", "PUT"],
      "type": "http",
      "requestBody": true,
      "autoRetryEnabled": true,
      "autoRetryPeriodMinutes": 1,
      "autoRetryMaxAttempts": 5
    }
  ],
  "configDefs": [
    {
      "param": "openmrsBaseUrl",
      "displayName": "OpenMRS FHIR base URL",
      "description": "e.g. https://example.org/openmrs/ws/fhir2/R4",
      "type": "string",
      "defaultValue": "https://example.org/openmrs/ws/fhir2/R4"
    },
    {
      "param": "advapacsBaseUrl",
      "displayName": "AdvaPACS FHIR base URL",
      "description": "e.g. https://usa1.api.integration.advapacs.com/fhir",
      "type": "string",
      "defaultValue": "https://example.api.integration.advapacs.com/fhir"
    },
    {
      "param": "logLevel",
      "displayName": "Log level",
      "type": "option",
      "values": ["debug", "info", "warn", "error"],
      "defaultValue": "info"
    },
    {
      "param": "patientIdentifierSystem",
      "displayName": "Patient identifier system",
      "description": "FHIR identifier system used to reference the patient on outbound ServiceRequests, e.g. http://www.pih.org/identifiers/lesotho/emr-id",
      "type": "string",
      "defaultValue": "http://www.pih.org/identifiers/lesotho/emr-id"
    }
  ]
}
