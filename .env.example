# Local env-var reference for this mediator, loaded via `dotenv` by both
# `npm start` (src/index.js) and `node scripts/setupOpenhim.js` run standalone.
# Usage: `cp .env.example .env`, then fill in real values.
#
# This is NOT the same as a distro-tools instance's own `env` file (see
# README's "Running the full stack locally (via distro-tools)") -- that file
# is what actually configures the mediator container in the supported
# Docker-based flow, and some of these same settings live there under
# different, `ADVAPACS_MEDIATOR_*`-prefixed names (see distro-tools'
# docker/services/openhim-advapacs-mediator.yaml).
#
# Use *this* file for: running `node scripts/setupOpenhim.js` directly
# against a running instance's OpenHIM admin API (e.g. to force a
# re-provision -- see README), or for quick ad-hoc local debugging of the
# mediator process itself outside Docker.

# OpenHIM core registration
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=
# http:// or https://. distro-tools' openhim fragment serves the admin API over plain HTTP.
OPENHIM_API_URL=http://localhost:8081
# Only for an https:// OPENHIM_API_URL with a self-signed certificate.
OPENHIM_TRUST_SELF_SIGNED=false

# Mediator server
MEDIATOR_PORT=3500
LOG_LEVEL=info

# How OpenMRS ServiceRequests reach us: 'push' mounts POST /fhir/ServiceRequest
# for OpenMRS (or an event listener module) to call; 'poll' instead pulls from
# OpenMRS's FHIR ServiceRequest search on an interval, which needs an OpenMRS whose
# FHIR2 module has FM2-708. See src/lib/orderPoller.js.
ORDER_INGESTION_MODE=poll
ORDER_POLL_INTERVAL_MS=15000

# OpenHIM's router (channel-serving port, distinct from OPENHIM_API_URL's admin
# API). orderPoller.js POSTs each polled order (as an order Bundle) here instead of calling
# orderRelay.js in-process, so the hop is visible/retryable as an OpenHIM
# transaction. When run via a distro-tools instance that includes the
# openhim-advapacs-mediator fragment, this is overridden to
# http://openhim-core:5001 (that fragment's own openhim-core service key).
OPENHIM_ROUTER_URL=http://localhost:5001

# Credentials orderPoller.js authenticates with (HTTP Basic auth) against the
# inbound "OpenMRS to Mediator Order Push" OpenHIM channel, now authType:
# "private". scripts/setupOpenhim.js registers a matching OpenHIM Client (role
# "openmrs") from these values on every run. In push mode, OpenMRS's own
# event-listener module must send the same credentials.
OPENHIM_INBOUND_CLIENT_ID=openmrs
OPENHIM_INBOUND_CLIENT_PASSWORD=

# Shared secret required as the `X-Mediator-Secret` header on every POST to
# this mediator's /fhir/ServiceRequest and /results/advapacs-event -- an app-level backstop independent of
# OpenHIM channel auth (protects direct access too). Both orderPoller.js and
# (in push mode) OpenMRS's own module must send this. Generate with
# `openssl rand -hex 32`.
MEDIATOR_INBOUND_SECRET=

# OpenMRS FHIR2 module -- if OpenMRS runs on this same host and the mediator
# is running in Docker (e.g. via distro-tools), use
# http://host.docker.internal:8080/openmrs, not localhost (which inside the
# mediator's container means the container itself, not the host machine).
OPENMRS_BASE_URL=https://example.org/openmrs
OPENMRS_FHIR_PATH=/ws/fhir2/R4
OPENMRS_USERNAME=
OPENMRS_PASSWORD=

# FHIR identifier system used to reference the patient on outbound
# ServiceRequests (orderRelay.js), instead of an OpenMRS-internal UUID.
# Site-specific -- a different PIH site would use a different system URI.
ADVAPACS_PATIENT_IDENTIFIER_SYSTEM=http://www.pih.org/identifiers/lesotho/emr-id

# FHIR identifier system under which the ordering clinician (Practitioner) is
# sent to and matched in AdvaPACS, with the OpenMRS provider UUID as its value
# (orderRelay.js). Must be registered as an Assigning Authority in AdvaPACS,
# or AdvaPACS rejects the Practitioner.
# Optional -- if unset, ServiceRequests are sent without a requester.
ADVAPACS_PRACTITIONER_IDENTIFIER_SYSTEM=http://www.pih.org/identifiers/lesotho/provider-uuid

# AdvaPACS Site for each order (orderRelay.js, siteLocation.js): maps the
# OpenMRS Visit Location the order was placed under (by uuid) to the
# identifier of an AdvaPACS Site (Configuration > Organisations), as
# <visit-location-uuid>=<site-identifier>,... The Site identifiers differ
# between AdvaPACS setups (e.g. LS-DM-BOTS on demo, LS-BOTS on production).
# Optional -- if unset, ServiceRequests are sent without a location or
# Organisation (performer). If set,
# an order whose Visit Location can't be found or isn't in the map fails (and
# can be re-run from OpenHIM once fixed); there's no fallback Site.
ADVAPACS_SITE_MAP=14301646-9256-4b8a-85aa-74bb720b5b43=LS-DM-BOTS,873e70ff-a3b4-4656-a9e5-cfe11d6470cd=LS-DM-MOTE

# Identifier of the AdvaPACS Organisation the Sites above must belong to, so a
# Site identifier from another Organisation (e.g. production's) never matches.
# Optional, and only used with ADVAPACS_SITE_MAP.
ADVAPACS_ORGANIZATION=LS-DM

# Imaging modality for each order (modalityMap.js, UHM-9616): a table of
# OpenMRS concept uuid -> DICOM modality code, built from the concepts'
# mappings to MODALITY_SOURCE (a concept source name or uuid), loaded from
# OpenMRS's REST API at startup and every MODALITY_MAP_REFRESH_MS, or every
# MODALITY_MAP_RETRY_MS until a load succeeds. Relaying an order makes no
# OpenMRS call. An orderable that isn't in the table is sent as CR, with a
# warning. Until the table has first loaded (an empty load counts as a
# failure), orders are held: the poller doesn't poll, the relay answers so
# OpenHIM retries the order every minute (up to 30 times), and /health is 503. DX and RF are always
# sent as CR: that's set in modalityMap.js (MODALITY_SUBSTITUTIONS), not
# configurable. All optional; empty means the default.
MODALITY_SOURCE=DCM
MODALITY_MAP_REFRESH_MS=3600000
MODALITY_MAP_RETRY_MS=10000

# AdvaPACS FHIR API. ADVAPACS_BASE_URL is the *real* AdvaPACS host -- only
# read by scripts/setupOpenhim.js to configure the outbound channel's route
# target, never called directly by the running app anymore. advapacsClient.js
# instead calls ADVAPACS_CHANNEL_URL, OpenHIM's outbound channel, which proxies
# on to ADVAPACS_BASE_URL (see mediatorConfig.json's "Mediator to AdvaPACS
# order push" channel). When run via a distro-tools instance, ADVAPACS_CHANNEL_URL
# is overridden to http://openhim-core:5001/advapacs.
ADVAPACS_BASE_URL=https://usa1.api.integration.advapacs.com/fhir/R5
ADVAPACS_CHANNEL_URL=http://localhost:5001/advapacs
ADVAPACS_CLIENT_ID=
ADVAPACS_CLIENT_SECRET=

# AdvaPACS's webhook calls OpenHIM's "AdvaPACS to Mediator Study and Report
# Webhook" channel with Basic auth, as an OpenHIM Client: this is that
# Client's password (and the password set in AdvaPACS's webhook), and
# ADVAPACS_WEBHOOK_CLIENT_ID its id and username. scripts/setupOpenhim.js creates the Client; if this is unset
# it creates none and the channel accepts no one. See README's "AdvaPACS
# webhook". Generate with `openssl rand -hex 32`.
ADVAPACS_WEBHOOK_SECRET=
ADVAPACS_WEBHOOK_CLIENT_ID=advapacs

# The identifier system under which AdvaPACS carries our radiology accession
# number, on orders we send and on studies/reports it sends back. Results are
# matched by this system only. Optional; this is the default.
ADVAPACS_ACCESSION_NUMBER_SYSTEM=http://www.pih.org/identifiers/lesotho/radiology-accession-number

# The mediator POSTs radiology results to OpenMRS's radiologyapp REST endpoints
# (/ws/rest/v1/radiologyapp/study and /report) through OpenHIM's private
# "Mediator to OpenMRS Radiology Results" channel, authenticating as this
# OpenHIM Client (Basic auth); OpenHIM calls OpenMRS with OPENMRS_USERNAME and
# OPENMRS_PASSWORD. scripts/setupOpenhim.js creates the Client; if the password
# is unset it creates none and the channel accepts no one. The route goes to
# OPENMRS_BASE_URL, assuming OpenHIM and OpenMRS run on the same server.
# OPENMRS_RESULTS_CHANNEL_URL is the channel's address as seen by the mediator
# (distro-tools: http://openhim-core:5001/openmrs). Generate the password with
# `openssl rand -hex 32`. The same Client and password also carry the hand-off
# of each webhook event to OpenHIM's "AdvaPACS Event Processing" channel; if the
# password (or MEDIATOR_INBOUND_SECRET) is unset, the mediator logs an error at
# startup and answers every webhook event 503.
OPENHIM_RESULTS_CLIENT_ID=advapacs-mediator
OPENHIM_RESULTS_CLIENT_PASSWORD=
OPENMRS_RESULTS_CHANNEL_URL=http://localhost:5001/openmrs

# The OpenMRS patient identifier type (uuid) that matches
# ADVAPACS_PATIENT_IDENTIFIER_SYSTEM (the EMR ID). resultHandler.js sends it with
# each study/report import so OpenMRS can find the patient. Required: if unset,
# processing fails and OpenHIM retries each event (then marks it Failed) until
# it is set.
OPENMRS_PATIENT_IDENTIFIER_TYPE_UUID=
